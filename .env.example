# Copy to `.env` (git-ignored) and fill in real values.
# docker compose reads this file automatically.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=smartstock
MYSQL_USER=smartstock
MYSQL_PASSWORD=change-me

# --- API ---
# Used by the app when running outside docker (IDE / mvn spring-boot:run)
DB_URL=jdbc:mysql://localhost:3306/smartstock?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=smartstock
DB_PASSWORD=change-me

# >= 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# --- LLM (optional). Leave LLM_API_KEY empty to use MockLlmService ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Dev only ---
SPRING_PROFILES_ACTIVE=dev
