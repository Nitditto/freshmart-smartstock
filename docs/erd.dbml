// SmartStock (FreshMart) ERD, transcribed from src/main/resources/db/migration/V1__init_schema.sql.
// Paste into https://dbdiagram.io to view or edit. The SQL migration stays the single source of truth.

Project smartstock {
  database_type: 'MySQL'
  Note: 'Kho FreshMart: tồn kho chỉ đổi khi xác nhận phiếu nhập / phiếu xuất. Mọi quan hệ đều 1-N.'
}

Enum role {
  ADMIN
  STAFF
}

Enum document_status {
  DRAFT
  CONFIRMED
  CANCELLED
}

Enum issue_reason {
  SALE
  DAMAGED [note: 'Chỉ ADMIN được xác nhận']
  INTERNAL
}

Table users {
  id bigint [pk, increment]
  full_name varchar(150) [not null]
  email varchar(190) [not null, unique]
  password_hash varchar(100) [not null, note: 'BCrypt, không bao giờ trả ra API']
  role role [not null]
  is_active boolean [not null, default: true]
  created_at datetime(6) [not null]
}

Table categories {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
}

Table suppliers {
  id bigint [pk, increment]
  name varchar(150) [not null]
  phone varchar(30)
  address varchar(255)
}

Table products {
  id bigint [pk, increment]
  sku varchar(50) [not null, unique]
  name varchar(200) [not null]
  category_id bigint [not null, ref: > categories.id]
  unit varchar(30) [not null]
  price decimal(18,2) [not null, note: 'CHECK >= 0']
  quantity_in_stock int [not null, default: 0, note: 'CHECK >= 0, chỉ đổi khi xác nhận chứng từ']
  min_stock int [not null, default: 0, note: 'CHECK >= 0']
  is_active boolean [not null, default: true, note: 'Xóa mềm: false = đã ẩn']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]

  indexes {
    category_id
    name
    (is_active, quantity_in_stock, min_stock) [note: 'low-stock']
  }
}

Table stock_receipts {
  id bigint [pk, increment]
  code varchar(30) [not null, unique, note: 'PN-yyyyMMdd-xxx']
  supplier_id bigint [not null, ref: > suppliers.id]
  status document_status [not null]
  note varchar(500)
  created_by bigint [not null, ref: > users.id]
  created_at datetime(6) [not null]
  confirmed_at datetime(6)

  indexes {
    (status, created_at)
    created_by
  }
}

Table stock_receipt_details {
  id bigint [pk, increment]
  receipt_id bigint [not null]
  product_id bigint [not null, ref: > products.id]
  quantity int [not null, note: 'CHECK > 0']
  unit_price decimal(18,2) [not null, note: 'CHECK >= 0']

  indexes {
    (receipt_id, product_id) [unique, note: 'Một sản phẩm chỉ một dòng trong mỗi phiếu']
    product_id
  }
}

Table stock_issues {
  id bigint [pk, increment]
  code varchar(30) [not null, unique, note: 'PX-yyyyMMdd-xxx']
  reason issue_reason [not null]
  status document_status [not null]
  note varchar(500)
  created_by bigint [not null, ref: > users.id]
  created_at datetime(6) [not null]
  confirmed_at datetime(6)

  indexes {
    (status, created_at)
    created_by
  }
}

Table stock_issue_details {
  id bigint [pk, increment]
  issue_id bigint [not null]
  product_id bigint [not null, ref: > products.id]
  quantity int [not null, note: 'CHECK > 0']

  indexes {
    (issue_id, product_id) [unique, note: 'Một sản phẩm chỉ một dòng trong mỗi phiếu']
    product_id
  }
}

Table document_counters {
  id bigint [pk, increment]
  prefix varchar(5) [not null, note: 'PN hoặc PX']
  counter_date date [not null]
  last_seq int [not null, default: 0]

  Note: 'Bộ đếm mã chứng từ theo ngày; không có khóa ngoại'

  indexes {
    (prefix, counter_date) [unique, note: 'Mã reset mỗi ngày']
  }
}

// Header -> detail: deleting a document removes its lines (ON DELETE CASCADE in V1).
Ref: stock_receipt_details.receipt_id > stock_receipts.id [delete: cascade]
Ref: stock_issue_details.issue_id > stock_issues.id [delete: cascade]
